# Copy to .env.local (never commit it). Each key is only needed for one feature.

# builder/ (the Lovable-style chat + preview). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# seo-research / seo-checkup skills (DataForSEO MCP). https://app.dataforseo.com/api-access
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=

# site-care publishing scripts: a fine-grained GitHub token for THIS repo only
# (Contents: read/write, Pull requests: read/write, Deployments: read)
GITHUB_TOKEN=
