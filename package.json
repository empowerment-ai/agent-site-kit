{
  "name": "agent-site-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Build a small-business website with Claude Code, then let an AI agent run it. No WordPress.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "check": "node scripts/check-content.mjs",
    "prebuild": "npm run check",
    "build": "next build",
    "start": "next start",
    "builder": "npm --prefix builder start",
    "care:propose": "node scripts/site-care/propose.mjs",
    "care:publish": "node scripts/site-care/publish.mjs",
    "care:undo": "node scripts/site-care/undo.mjs",
    "care:status": "node scripts/site-care/status.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.0.14",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  }
}
